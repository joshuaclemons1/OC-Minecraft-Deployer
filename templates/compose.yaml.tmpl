# Generated by OC-Minecraft-Deployer. Edits here are overwritten on the next
# install or `mcd update`; change /opt/mcd/mcd.conf instead.

name: mcd

services:
  crafty:
    image: "@@CRAFTY_IMAGE@@:@@CRAFTY_TAG@@"
    container_name: mcd-crafty
    restart: unless-stopped
    environment:
      TZ: "@@TZ@@"
    # Note what is NOT here: port 8443. The panel is never published to the
    # host. Caddy reaches it over the internal network and is the only way in,
    # so the panel is unreachable except through TLS on a real certificate.
    ports:
      - "@@MC_PORT_START@@-@@MC_PORT_END@@:@@MC_PORT_START@@-@@MC_PORT_END@@"
      - "@@BEDROCK_PORT@@:@@BEDROCK_PORT@@/udp"
    volumes:
      - "@@MCD_DATA@@/servers:/crafty/servers"
      - "@@MCD_DATA@@/config:/crafty/app/config"
      - "@@MCD_DATA@@/logs:/crafty/logs"
      - "@@MCD_DATA@@/backups:/crafty/backups"
      - "@@MCD_DATA@@/import:/crafty/import"
      # Temurin 21 and 25 from the host. The image only ships 8/11/17, which
      # caps it at Minecraft 1.20.4 without this.
      - "@@MCD_JAVA@@:/opt/java:ro"
    networks:
      - mcd

  caddy:
    image: "@@CADDY_IMAGE@@"
    container_name: mcd-caddy
    restart: unless-stopped
    depends_on:
      - crafty
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - "@@MCD_CADDY@@/Caddyfile:/etc/caddy/Caddyfile:ro"
      # Certificates live here. Losing this directory means re-issuing on every
      # restart, which will hit Let's Encrypt rate limits.
      - "@@MCD_CADDY@@/data:/data"
      - "@@MCD_CADDY@@/config:/config"
    networks:
      - mcd

networks:
  mcd:
    name: mcd
