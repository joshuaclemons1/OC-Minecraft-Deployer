# Generated by OC-Minecraft-Deployer. Edits here are overwritten on the next
# install or `mcd update`; change /opt/mcd/mcd.conf instead.

{
	email @@EMAIL@@
}

@@HOSTNAME@@ {
	encode zstd gzip

	# Crafty serves HTTPS on 8443 using its own self-signed certificate, so
	# the proxy hop must be https:// and must skip verification. Without
	# tls_insecure_skip_verify every request fails with a TLS error that
	# reads like a Caddy misconfiguration rather than an expected hop.
	#
	# This is not a weakening of the public TLS: the browser-facing
	# certificate is a real Let's Encrypt one. This hop is container-to-
	# container on an internal Docker network that is not routable from
	# outside the host.
	reverse_proxy https://crafty:8443 {
		transport http {
			tls_insecure_skip_verify
		}

		# Crafty's websockets (live console, server status) need these to
		# survive the proxy, and a long read timeout so an idle console is
		# not dropped mid-session.
		header_up Host {upstream_hostport}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
