# This project is authored on Windows and executed on Linux. Shell scripts MUST
# check out with LF endings or the kernel reads "#!/usr/bin/env bash\r" and the
# script dies with "bad interpreter: no such file or directory".
* text=auto eol=lf

*.sh      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.conf    text eol=lf
*.tmpl    text eol=lf
*.service text eol=lf
*.timer   text eol=lf
Caddyfile text eol=lf
bin/mcd   text eol=lf

*.png binary
*.jpg binary
*.gz  binary
*.zip binary
